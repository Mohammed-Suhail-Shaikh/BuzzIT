PORT=3001
# Comma-separated browser origins (scheme + host + port). Match your Vite URL(s).
# On Vercel, you can set WEB_ORIGIN=* so any BuzzIT frontend URL can call the API (good for previews).
# Or list explicit origins, e.g. https://buzzit.vercel.app,http://localhost:5173
WEB_ORIGIN=http://localhost:5173,http://localhost:5174
# Must match VITE_GOOGLE_CLIENT_ID in web/.env
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=change_me_to_a_long_random_string_at_least_16_chars

